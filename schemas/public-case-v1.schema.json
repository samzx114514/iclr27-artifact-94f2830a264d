{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/githarness/public-case-v1.schema.json",
  "title": "MTAgentBench public case v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["task_id", "domain", "turns", "runtime_assets", "schema_version"],
  "properties": {
    "task_id": {"type": "string", "minLength": 1},
    "domain": {"enum": ["math", "sql", "search", "research", "code"]},
    "turns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"const": "user"},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "runtime_assets": {"type": "object"},
    "schema_version": {"const": 1}
  }
}
