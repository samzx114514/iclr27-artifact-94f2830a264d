# OpenAI-compatible endpoint. Never commit a real .env file.
LLM_BASE_URL=https://example.invalid/v1
LLM_API_KEY=replace-me

# Optional benchmark assets. Keep data outside the repository.
MTAGENTBENCH_DATA_ROOT=/path/to/official/benchmark/assets

# Optional fixed BrowseComp-Plus retrieval service for paper-protocol Search.
BROWSECOMP_SEARCH_URL=https://your-retriever.example/v1
BROWSECOMP_API_KEY=replace-me

# Optional BoCha-compatible provider for Research.
BOCHA_API_KEY=replace-me
